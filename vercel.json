{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/handler?apiPath=:path*" },
    { "source": "/resume/:path*", "destination": "/api/handler?resumePath=:path*" },
    { "source": "/", "destination": "/api/handler" }
  ]
}
